{
  "id": "rpi_pico2",
  "schema": 1,
  "units": "mm",
  "names": ["raspberry pi pico 2", "rpi pico 2", "rpi pico2", "pico 2", "pico2", "raspberry pi pico2", "pi pico 2"],
  "kind": "module",
  "source": "Raspberry Pi Pico 2 datasheet (RP-008304-DS), section 'Mechanical specification': PCB 51 x 21 x 1 mm, mounting holes 2.1 mm on a 47.0 x 11.4 mm pattern (2.0 mm from the short edges, 4.8 mm from the long edges), 40 castellated pins at 2.54 mm pitch in two rows 17.78 mm apart. Micro-USB B receptacle on top at the short edge: about 8.0 wide, 5.5 deep, 2.8 tall, overhanging the PCB edge by about 1.3 (requirements.md A4; approximate, check against the official STEP).",
  "frame": "module: origin at the PCB min corner, PCB bottom at Z = 0, components on +Z, USB end at -X",
  "params": {
    "pcb_length": {"default": 51.0, "source": "datasheet: board outline"},
    "pcb_width": {"default": 21.0, "source": "datasheet: board outline"},
    "pcb_thickness": {"default": 1.0, "source": "datasheet: PCB thickness"},
    "hole_diameter": {"default": 2.1, "source": "datasheet: mounting holes"},
    "hole_from_short_edge": {"default": 2.0, "source": "datasheet: hole pattern 47.0 x 11.4"},
    "hole_from_long_edge": {"default": 4.8, "source": "datasheet: hole pattern 47.0 x 11.4"},
    "usb_width": {"default": 8.0, "source": "micro-USB B receptacle body width (requirements.md A4)"},
    "usb_depth": {"default": 5.5, "source": "micro-USB B receptacle body depth (requirements.md A4)"},
    "usb_height": {"default": 2.8, "source": "micro-USB B receptacle body height (requirements.md A4)"},
    "usb_overhang": {"default": 1.3, "source": "receptacle overhang beyond the PCB edge (requirements.md A4, R4)"},
    "pin_pitch": {"default": 2.54, "source": "datasheet: pin pitch"},
    "pin_row_spacing": {"default": 17.78, "source": "datasheet: row spacing"},
    "pin_from_short_edge": {"default": 1.37, "source": "datasheet: first pin centre from the USB edge"},
    "top_parts_height": {"default": 1.5, "source": "tallest top-side part other than the receptacle (requirements.md M-PICO2)"}
  },
  "datasheet_size": ["pcb_length", "pcb_width", "pcb_thickness"],
  "size_of": "pcb",
  "size_tolerance": 0.2,
  "geometry": [
    {"id": "pcb", "primitive": "box", "size": ["pcb_length", "pcb_width", "pcb_thickness"], "at": [0, 0, 0]},
    {"id": "usb", "primitive": "box", "size": ["usb_depth", "usb_width", "usb_height"],
     "at": ["-usb_overhang", "(pcb_width - usb_width) / 2", "pcb_thickness"]}
  ],
  "keepouts": [
    {"id": "component_side", "primitive": "box", "size": ["pcb_length", "pcb_width", "top_parts_height"], "at": [0, 0, "pcb_thickness"]}
  ],
  "interfaces": [{"id": "mount", "kind": "mount_holes", "holes": "HOLE", "seat": "PCB_BOTTOM", "top": "PCB_TOP", "source": "catalogue data (generalize iteration 001, delta D1): the mounting-hole axis list, the plane the part rests on when seated over its holes, and the plane its component keep-out starts from. thread: generalize delta 002 D2, Raspberry Pi Pico 2 datasheet gives 2.1 mm drilled holes; M2 is the screw that fits them (engineering convention, uncertainty low)", "thread": 2.0}],
  "datums": {
    "USB_MOUTH": {"kind": "point", "at": ["-usb_overhang", "pcb_width / 2", "pcb_thickness + usb_height / 2"]},
    "USB_AXIS": {"kind": "axis", "at": ["-usb_overhang", "pcb_width / 2", "pcb_thickness + usb_height / 2"], "dir": [-1, 0, 0]},
    "PCB_BOTTOM": {"kind": "plane", "at": [0, 0, 0], "normal": [0, 0, -1]},
    "PCB_TOP": {"kind": "plane", "at": [0, 0, "pcb_thickness"], "normal": [0, 0, 1]},
    "HOLE": {"kind": "axis_list", "dir": [0, 0, 1], "diameter": "hole_diameter",
             "at": [["hole_from_short_edge", "hole_from_long_edge", 0],
                    ["pcb_length - hole_from_short_edge", "hole_from_long_edge", 0],
                    ["hole_from_short_edge", "pcb_width - hole_from_long_edge", 0],
                    ["pcb_length - hole_from_short_edge", "pcb_width - hole_from_long_edge", 0]]},
    "PINS_A": {"kind": "axis_list", "dir": [0, 0, -1], "count": 20,
               "start": ["pin_from_short_edge", "(pcb_width - pin_row_spacing) / 2", 0], "step": ["pin_pitch", 0, 0]},
    "PINS_B": {"kind": "axis_list", "dir": [0, 0, -1], "count": 20,
               "start": ["pin_from_short_edge", "(pcb_width + pin_row_spacing) / 2", 0], "step": ["pin_pitch", 0, 0]}
  },
  "connectors": [
    {"name": "usb", "mouth": "USB_MOUTH", "axis": "USB_AXIS", "mates": "plug_microusb_b", "overhang_datum": "USB_MOUTH"}
  ],
  "mount": {"stack_options": ["header_male_2p54", "header_female_2p54"], "stack_datum": "PCB_BOTTOM",
            "stack_pins": ["PINS_A", "PINS_B"],
            "notes": "stack_options[0] is the catalogue default: soldered male headers (requirements A3), used when the text names no mounting (assembly ChooseStack evidence gate, ARCHITECTURE.md 7.10)"},
  "self_checks": [
    {"name": "R2 PCB thickness", "expr": "pcb.size_z", "value": 1.0, "tol": 0.1},
    {"name": "R2 hole diameter", "expr": "HOLE.diameter", "value": 2.1, "tol": 0.1},
    {"name": "R2 hole pitch X", "expr": "HOLE[1].x - HOLE[0].x", "value": 47.0, "tol": 0.1},
    {"name": "R2 hole pitch Y", "expr": "HOLE[2].y - HOLE[0].y", "value": 11.4, "tol": 0.1},
    {"name": "R3 USB axis along -X", "expr": "USB_AXIS.dx", "value": -1, "tol": 1e-6},
    {"name": "R3 receptacle at the -X end", "expr": "usb.min_x", "op": "le", "value": 0, "tol": 0},
    {"name": "R3 components on +Z", "expr": "usb.min_z - PCB_TOP.z", "value": 0, "tol": 1e-6},
    {"name": "R4 receptacle overhang", "expr": "-usb.min_x", "value": 1.3, "tol": 0.3},
    {"name": "pin row spacing", "expr": "PINS_B[0].y - PINS_A[0].y", "value": 17.78, "tol": 0.05},
    {"name": "pin pitch", "expr": "PINS_A[1].x - PINS_A[0].x", "value": 2.54, "tol": 0.02}
  ]
}
