 "kind": "mech",
 "source": "GT2 20-tooth timing pulley for 6 mm belt (typical 3D-printer part, e.g. Gates GT2 / common 20T-5 mm-bore datasheets): bore 5 mm, tooth outer diameter 16.0 mm, hub OD 16 mm, flange OD 18 mm, belt width 6 mm, pitch 2 mm so pitch diameter = 20*2/pi = 12.73 mm. Axial layout (hub 8, flange 1, teeth 7, flange 1 = 17 mm total) is the common 5 mm-bore stock part; vendors vary the hub length 7-9 mm (assumed, +/-1 mm), so measure the owner's pulley. Set screw not modelled.",
 "frame": "module: axis along Z, origin at the centre of the shaft-entry face of the hub, hub toward +Z first, then the lower flange, the toothed band, the upper flange",
 "params": {
  "bore_diameter": {
   "default": 5.0,
   "source": "datasheet: bore for a 5 mm shaft (NEMA 17 shaft per NEMA ICS 16)"
  },
  "teeth": {
   "default": 20,
   "source": "datasheet: tooth count"
  },
  "pitch": {
   "default": 2.0,
   "source": "GT2 pitch"
  },
  "pitch_diameter": {
   "default": 12.732,
   "source": "computed: teeth * pitch / pi = 12.732"
  },
  "tooth_od": {
   "default": 16.0,
   "source": "datasheet: tooth outer diameter"
  },
  "hub_diameter": {
   "default": 16.0,
   "source": "datasheet: hub OD"
  },
  "flange_diameter": {
   "default": 18.0,
   "source": "datasheet: flange OD"
  },
  "belt_width": {
   "default": 6.0,
   "source": "datasheet: belt width"
  },
  "hub_length": {
   "default": 8.0,
   "source": "assumed from common 5 mm-bore 20T stock (+/-1 mm)"
  },
  "flange_thickness": {
   "default": 1.0,
   "source": "assumed from common 20T stock (+/-0.3 mm)"
  },
  "tooth_length": {
   "default": 7.0,
   "source": "assumed: belt width plus 1 mm band between the flanges"
  }
 },
