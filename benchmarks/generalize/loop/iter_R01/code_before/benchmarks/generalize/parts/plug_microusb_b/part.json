{
  "id": "plug_microusb_b",
  "schema": 1,
  "units": "mm",
  "names": ["micro-usb plug", "micro usb plug", "micro-usb cable", "micro usb cable", "micro-usb b plug", "usb cable plug"],
  "kind": "plug",
  "source": "USB 2.0 Micro-USB Cables and Connectors Specification rev 1.01, plug shell about 6.85 x 1.8 mm, mated depth about 5.0 mm; overmold 10.0 x 7.0 x 20 mm is a typical cable (requirements.md A6, M-PLUG-USB). Measure the owner's cable.",
  "frame": "plug: origin at the tip, centred in Y and Z; the plug body runs along +X; it is inserted by moving along -X (mating direction = -PLUG_AXIS)",
  "params": {
    "shell_width": {"default": 6.9, "source": "spec: plug shell width"},
    "shell_height": {"default": 1.85, "source": "spec: plug shell height"},
    "insert_depth": {"default": 5.0, "source": "spec: mated depth into the receptacle"},
    "exposed_shell": {"default": 1.5, "source": "typical cable: shell visible outside the receptacle at full mate"},
    "overmold_width": {"default": 10.0, "source": "typical cable overmold (requirements.md A6)"},
    "overmold_height": {"default": 7.0, "source": "typical cable overmold (requirements.md A6)"},
    "overmold_length": {"default": 20.0, "source": "typical cable overmold (requirements.md A6)"}
  },
  "datasheet_size": ["insert_depth + exposed_shell + overmold_length", "overmold_width", "overmold_height"],
  "size_tolerance": 0.3,
  "geometry": [
    {"id": "shell", "primitive": "box", "size": ["insert_depth + exposed_shell", "shell_width", "shell_height"],
     "at": [0, "-shell_width / 2", "-shell_height / 2"]},
    {"id": "overmold", "primitive": "box", "size": ["overmold_length", "overmold_width", "overmold_height"],
     "at": ["insert_depth + exposed_shell", "-overmold_width / 2", "-overmold_height / 2"]}
  ],
  "datums": {
    "PLUG_TIP": {"kind": "point", "at": [0, 0, 0]},
    "PLUG_AXIS": {"kind": "axis", "at": [0, 0, 0], "dir": [1, 0, 0]},
    "SEAT": {"kind": "point", "at": ["insert_depth", 0, 0]},
    "OVERMOLD_FACE": {"kind": "plane", "at": ["insert_depth + exposed_shell", 0, 0], "normal": [-1, 0, 0]}
  },
  "connectors": [],
  "self_checks": [
    {"name": "shell width", "expr": "shell.size_y", "value": 6.9, "tol": 0.2},
    {"name": "shell height", "expr": "shell.size_z", "value": 1.85, "tol": 0.1},
    {"name": "overmold face beyond the seat", "expr": "OVERMOLD_FACE.x - SEAT.x", "op": "ge", "value": 0, "tol": 0}
  ]
}
