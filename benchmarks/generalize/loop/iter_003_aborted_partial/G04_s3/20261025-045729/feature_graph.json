        "y0": "min(board.bbox.min_y - spec.board_clearance - rules.design_margin, board.HOLE[0].y - max(hole_ko_0.d, rules.driver_diameter)/2 - rules.design_margin, board.HOLE[1].y - max(hole_ko_1.d, rules.driver_diameter)/2 - rules.design_margin, board.HOLE[2].y - max(hole_ko_2.d, rules.driver_diameter)/2 - rules.design_margin, board.HOLE[3].y - max(hole_ko_3.d, rules.driver_diameter)/2 - rules.design_margin)",
        "y1": "max(board.bbox.max_y + spec.board_clearance + rules.design_margin, board.HOLE[0].y + max(hole_ko_0.d, rules.driver_diameter)/2 + rules.design_margin, board.HOLE[1].y + max(hole_ko_1.d, rules.driver_diameter)/2 + rules.design_margin, board.HOLE[2].y + max(hole_ko_2.d, rules.driver_diameter)/2 + rules.design_margin, board.HOLE[3].y + max(hole_ko_3.d, rules.driver_diameter)/2 + rules.design_margin)",
        "z0": "min(board.PCB_BOTTOM.z - spec.keepout_below - rules.design_margin, board.PCB_BOTTOM.z - ((max(fastener.board.min_engagement, fastener.board.length - (board.PCB_TOP.z - board.PCB_BOTTOM.z))) + rules.design_margin) - rules.min_feature + floor - rules.design_margin)",
