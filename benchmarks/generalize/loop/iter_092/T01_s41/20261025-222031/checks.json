    "type": "form_evidence",
    "params": {
      "current": "plate",
      "expected": [],
      "quotes": [
        {
          "source": "request",
          "quote": "The platform should be about the size of an ordinary flat pedal (between 80 and 105 mm each way).",
          "match": "platform",
          "form": "plate"
        },
        {
          "source": "request",
          "quote": "It is printed on an FDM printer in PETG with no supports, and one printed adapter (or a left/right pair) goes on each pedal.",
          "match": "adapter",
          "form": "plate"
        },
        {
          "source": "L1.1",
          "quote": "The design shall carry one Shimano SM-SH51 cleat (catalogue cleat) with its mount face against the adapter's cleat seat, fastened by the cleat's own two bolt positions with standard M5 hardware (catalogue M5 socket-head bolts and M5 hex nuts), and shall declare the layout (cleat pose, bolts, nuts, grip features, print orientation).",
          "match": "adapter",
          "form": "plate"
        },
        {
          "source": "L1.3",
          "quote": "At every cleat position in that range the M5 hardware shall fit: each bolt head shall seat on the cleat and be reachable with a 4 mm hex key from the pedal side with the adapter off the pedal, each bolt shall engage its nut for its whole thickness, and no bolt tip shall reach the top face of the platform.",
          "match": "platform",
          "form": "plate"
        }
      ],
      "sources": [
