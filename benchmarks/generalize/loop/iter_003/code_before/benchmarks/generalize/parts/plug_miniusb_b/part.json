{
  "id": "plug_miniusb_b",
  "schema": 1,
  "units": "mm",
  "names": [
    "mini-usb plug",
    "mini usb plug",
    "mini-usb b plug",
    "mini usb cable",
    "mini-usb cable",
    "miniusb plug"
  ],
  "kind": "plug",
  "source": "USB 2.0 Mini-B connector spec (USB-IF Mini-B Cables and Connectors Specification rev 1.1): plug shell 6.8 x 3.0 mm, mated depth about 6.9 mm. Typical overmold 11 x 8 mm; length 20 mm assumed (+/-5). Measure the owner's cable.",
  "frame": "plug: origin at the tip, centred in Y and Z; the plug body runs along +X; it is inserted by moving along -X (mating direction = -PLUG_AXIS)",
  "params": {
    "shell_width": {
      "default": 6.8,
      "source": "spec: plug shell width (USB Mini-B)"
    },
    "shell_height": {
      "default": 3.0,
      "source": "spec: plug shell height (USB Mini-B)"
    },
    "insert_depth": {
      "default": 6.9,
      "source": "mated depth into the receptacle (see source; assumed where the spec gives a range)"
    },
    "exposed_shell": {
      "default": 1.5,
      "source": "assumed: shell visible outside the receptacle at full mate (cable-dependent, +/-1 mm)"
    },
    "overmold_width": {
      "default": 11.0,
      "source": "typical overmold width (cable-dependent; measure the owner's cable)"
    },
    "overmold_height": {
      "default": 8.0,
      "source": "typical overmold height (cable-dependent; measure the owner's cable)"
    },
    "overmold_length": {
      "default": 20.0,
      "source": "assumed overmold length (cable-dependent, +/-5 mm; strain relief excluded)"
    }
  },
  "datasheet_size": [
    "insert_depth + exposed_shell + overmold_length",
    "overmold_width",
    "overmold_height"
  ],
  "size_tolerance": 0.3,
  "geometry": [
    {
      "id": "shell",
      "primitive": "box",
      "size": [
        "insert_depth + exposed_shell",
        "shell_width",
        "shell_height"
      ],
      "at": [
        0,
        "-shell_width / 2",
        "-shell_height / 2"
      ]
    },
    {
      "id": "overmold",
      "primitive": "box",
      "size": [
        "overmold_length",
        "overmold_width",
        "overmold_height"
      ],
      "at": [
        "insert_depth + exposed_shell",
        "-overmold_width / 2",
        "-overmold_height / 2"
      ]
    }
  ],
  "datums": {
    "PLUG_TIP": {
      "kind": "point",
      "at": [
        0,
        0,
        0
      ]
    },
    "PLUG_AXIS": {
      "kind": "axis",
      "at": [
        0,
        0,
        0
      ],
      "dir": [
        1,
        0,
        0
      ]
    },
    "SEAT": {
      "kind": "point",
      "at": [
        "insert_depth",
        0,
        0
      ]
    },
    "OVERMOLD_FACE": {
      "kind": "plane",
      "at": [
        "insert_depth + exposed_shell",
        0,
        0
      ],
      "normal": [
        -1,
        0,
        0
      ]
    }
  },
  "connectors": [],
  "self_checks": [
    {
      "name": "shell width",
      "expr": "shell.size_y",
      "value": 6.8,
      "tol": 0.2
    },
    {
      "name": "shell height",
      "expr": "shell.size_z",
      "value": 3.0,
      "tol": 0.1
    },
    {
      "name": "overmold covers the shell width",
      "expr": "overmold_width - shell_width",
      "op": "ge",
      "value": 0,
      "tol": 0
    },
    {
      "name": "overmold covers the shell height",
      "expr": "overmold_height - shell_height",
      "op": "ge",
      "value": 0,
      "tol": 0
    },
    {
      "name": "overmold face beyond the seat",
      "expr": "OVERMOLD_FACE.x - SEAT.x",
      "op": "ge",
      "value": 0,
      "tol": 0
    }
  ]
}
