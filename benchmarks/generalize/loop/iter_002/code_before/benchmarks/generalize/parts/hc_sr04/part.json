  },
  "pin_pitch": {
   "default": 2.54,
   "source": "datasheet: header pitch"
  },
  "pin_inset": {
   "default": 2.0,
   "source": "assumed: header row centre from the -Y edge"
  },
  "header_body_height": {
   "default": 2.5,
