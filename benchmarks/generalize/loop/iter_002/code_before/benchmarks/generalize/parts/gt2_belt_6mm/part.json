{
 "id": "gt2_belt_6mm",
 "schema": 1,
 "units": "mm",
 "names": [
  "gt2 belt",
  "gt2 6mm belt",
  "gt2 6 mm belt",
  "6mm gt2 belt",
  "6 mm gt2 belt",
  "6mm belt",
  "6 mm belt",
  "gt2 timing belt",
  "timing belt"
 ],
 "kind": "mech",
 "source": "GT2 timing belt, 6 mm wide (Gates PowerGrip GT2 / common 3D-printer belt datasheets): pitch 2 mm, width 6 mm, total thickness 1.38 mm, tooth height 0.75 mm, pitch line offset about 0.254 mm from the tooth tip (Gates pitch line differential), minimum bending diameter about 20 mm for a toothed idler and about 20 mm smooth idler (assumed +/-5 mm). The belt is a closed loop; the model is one straight run (the span between two pulleys) of the requested length, with the teeth on the -Z face.",
 "frame": "belt run: origin at the centre of the start end of the run, belt along +X, width across Y, teeth on the -Z face, back on +Z, run thickness centred on Z = 0",
 "params": {
  "length": {
   "default": null,
   "from_request": true,
   "source": "request text: span length of the straight run"
  },
  "width": {
   "default": 6.0,
   "source": "datasheet: belt width"
  },
  "thickness": {
   "default": 1.38,
   "source": "datasheet: total thickness including teeth"
  },
  "pitch": {
   "default": 2.0,
   "source": "GT2 pitch"
  },
  "tooth_height": {
   "default": 0.75,
   "source": "datasheet: tooth height"
  },
  "pitch_line_offset": {
   "default": 0.254,
   "source": "Gates GT2 pitch line differential"
  },
  "min_bend_diameter": {
   "default": 20.0,
   "source": "assumed: minimum idler diameter for a 6 mm GT2 belt (+/-5 mm)"
  }
 },
 "gate_params": {
  "length": 100.0,
  "source": "sample size used only by the load-time validation gate; never a design value"
 },
 "datasheet_size": [
  "length",
  "width",
  "thickness"
 ],
 "size_tolerance": 0.05,
 "geometry": [
  {
   "id": "run",
   "primitive": "box",
   "size": [
    "length",
    "width",
    "thickness"
   ],
   "at": [
    0,
    "-width / 2",
    "-thickness / 2"
   ]
  }
 ],
 "keepouts": [
  {
   "id": "flutter_envelope",
   "primitive": "box",
   "size": [
    "length",
    "width",
    "thickness"
   ],
   "at": [
    0,
    "-width / 2",
    "-thickness / 2"
   ]
  }
 ],
