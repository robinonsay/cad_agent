   "kind": "axis",
   "at": [
    0,
    0,
    0
   ],
   "dir": [
    1,
    0,
    0
   ]
  },
  "BELT_PLANE": {
   "kind": "plane",
   "at": [
    0,
    0,
    0
   ],
