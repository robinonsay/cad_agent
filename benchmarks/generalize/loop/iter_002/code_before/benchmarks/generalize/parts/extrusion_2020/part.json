 "self_checks": [
  {
   "name": "section is 20 square",
   "expr": "body.size_x - body.size_y",
   "value": 0,
   "tol": 0.01
  },
  {
   "name": "slot opening narrower than the section",
   "expr": "width - slot_opening",
   "op": "ge",
   "value": 0,
   "tol": 0
  },
  {
   "name": "slot floor clears the centre bore",
   "expr": "width / 2 - slot_depth - bore_diameter / 2",
   "op": "ge",
   "value": 0,
   "tol": 0
  },
  {
   "name": "lips plus opening fill the slot face less the interior",
   "expr": "slot_inner_width - slot_opening",
