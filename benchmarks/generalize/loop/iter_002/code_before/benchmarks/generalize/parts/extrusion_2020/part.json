 "kind": "profile",
 "source": "2020 T-slot profile, Misumi HFS5-2020 drawing and the common 2020 V-slot/T-slot catalogues: 20 x 20 mm section, slot opening 6.2 mm, slot depth 6.1 mm, centre bore 4.2 mm (M5 tap drill), slot interior width about 11 mm behind a 1.8 mm lip (assumed from the same drawings; +/-0.3 mm between vendors). Length comes from the request. The slot channels and bore are not modelled as geometry (boxes and cylinders only): they are datums, and the body is the solid 20 x 20 envelope. Treat the slot/bore datums as the real extent and never place material in a slot except a designed tongue or T-nut.",
 "frame": "profile: axis along Z, origin at the centre of the section on the start end face, profile extends toward +Z; slots face +X, +Y, -X, -Y",
 "params": {
  "length": {
   "default": null,
   "from_request": true,
   "source": "request text"
  },
  "width": {
   "default": 20.0,
   "source": "profile nominal section"
  },
  "slot_opening": {
   "default": 6.2,
   "source": "Misumi HFS5-2020 drawing: slot opening"
  },
  "slot_depth": {
   "default": 6.1,
   "source": "Misumi HFS5-2020 drawing: slot depth from the face"
  },
  "lip_thickness": {
   "default": 1.8,
   "source": "assumed from the 2020 drawings: lip each side of the opening (uncertainty +/-0.3 mm)"
  },
  "slot_inner_width": {
   "default": 11.0,
   "source": "assumed from the 2020 drawings: slot width behind the lips (uncertainty +/-0.5 mm)"
  },
  "bore_diameter": {
   "default": 4.2,
   "source": "Misumi HFS5-2020 drawing: centre bore (M5 tap drill)"
  }
 },
 "gate_params": {
  "length": 100.0,
  "source": "sample size used only by the load-time validation gate; never a design value"
 },
