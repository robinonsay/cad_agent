    {
      "id": "cavity",
      "kind": "envelope",
      "primitive": "box",
      "params": {
        "x0": "board.bbox.min_x - spec.board_clearance - rules.design_margin",
        "x1": "board.bbox.max_x + spec.board_clearance + rules.design_margin",
        "y0": "board.bbox.min_y - spec.board_clearance - rules.design_margin",
        "y1": "board.bbox.max_y + spec.board_clearance + rules.design_margin",
        "z0": "board.PCB_BOTTOM.z - spec.keepout_below - rules.design_margin",
        "z1": "max(board.PCB_TOP.z + spec.keepout_above + rules.design_margin, board.bbox.max_z + spec.headroom + rules.design_margin)",
        "wall": "min(max(rules.wall_default, spec.wall_min), spec.wall_max)",
        "floor": "min(max(rules.floor_default, spec.wall_min), spec.wall_max)",
        "x": "x1 - x0",
        "y": "y1 - y0",
        "z": "z1 - z0",
        "cx": "(x0 + x1) / 2",
        "cy": "(y0 + y1) / 2"
      },
      "pose": {
        "at": "frame.origin",
        "offset": [
          "cx",
          "cy",
          "z0"
        ],
        "axis": null,
        "project_to": null,
        "rot_z": 0,
        "axis_dir": null
      },
      "body": null,
      "role": "cavity",
      "part": null,
      "source": "rule:cavity_from_contents",
      "free": [],
      "color": null,
      "group": null
    },
    {
      "id": "board_cut",
      "kind": "cut",
      "primitive": "box",
      "params": {
        "x": "cavity.wall + 2*rules.cut_overrun",
        "y": "max(board_plug_shell.cw, board_plug_overmold.cw) + 2*(rules.plug_to_opening + rules.design_margin)",
        "z": "max(board_plug_shell.ch, board_plug_overmold.ch) + 2*(rules.plug_to_opening + rules.design_margin)",
        "top": "board.USB_MOUTH.z + z/2",
        "cw": "max(board_plug_shell.cw, board_plug_overmold.cw) + 2*(rules.plug_to_opening + rules.design_margin)",
        "ch": "max(board_plug_shell.ch, board_plug_overmold.ch) + 2*(rules.plug_to_opening + rules.design_margin)"
      },
      "pose": {
        "at": "board.USB_MOUTH",
        "offset": [
          "cavity.x0 - cavity.wall/2 - board.USB_MOUTH.x",
          0,
          "-z/2"
        ],
        "axis": null,
        "project_to": null,
        "rot_z": 180.0,
        "axis_dir": null
      },
      "body": "base",
      "role": "port_cut",
      "part": null,
      "source": "rule:connector_to_cut(board.usb)",
      "free": [],
      "color": null,
      "group": null
    },
    {
      "id": "base",
      "kind": "body",
      "primitive": "shell",
      "params": {
        "wall": "cavity.wall",
        "floor": "cavity.floor",
        "split": "max(cavity.z1 + rules.lip_engagement + rules.design_margin, board_cut.top + rules.min_ligament + rules.design_margin)",
        "x": "cavity.x + 2*wall",
        "y": "cavity.y + 2*wall",
        "z": "split - cavity.z0 + floor",
        "open_top": 1
      },
      "pose": {
        "at": "frame.origin",
