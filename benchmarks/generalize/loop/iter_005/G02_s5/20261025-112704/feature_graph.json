      "kind": "envelope",
      "primitive": "box",
      "params": {
        "x0": "min(board.bbox.min_x - spec.board_clearance - rules.design_margin, board.HOLE[0].x - max(hole_ko_0.d, rules.driver_diameter)/2 - rules.design_margin, board.HOLE[1].x - max(hole_ko_1.d, rules.driver_diameter)/2 - rules.design_margin, board.HOLE[2].x - max(hole_ko_2.d, rules.driver_diameter)/2 - rules.design_margin, board.HOLE[3].x - max(hole_ko_3.d, rules.driver_diameter)/2 - rules.design_margin) - band",
        "x1": "max(board.bbox.max_x + spec.board_clearance + rules.design_margin, board.HOLE[0].x + max(hole_ko_0.d, rules.driver_diameter)/2 + rules.design_margin, board.HOLE[1].x + max(hole_ko_1.d, rules.driver_diameter)/2 + rules.design_margin, board.HOLE[2].x + max(hole_ko_2.d, rules.driver_diameter)/2 + rules.design_margin, board.HOLE[3].x + max(hole_ko_3.d, rules.driver_diameter)/2 + rules.design_margin) + band",
        "y0": "min(board.bbox.min_y - spec.board_clearance - rules.design_margin, board.HOLE[0].y - max(hole_ko_0.d, rules.driver_diameter)/2 - rules.design_margin, board.HOLE[1].y - max(hole_ko_1.d, rules.driver_diameter)/2 - rules.design_margin, board.HOLE[2].y - max(hole_ko_2.d, rules.driver_diameter)/2 - rules.design_margin, board.HOLE[3].y - max(hole_ko_3.d, rules.driver_diameter)/2 - rules.design_margin)",
        "y1": "max(board.bbox.max_y + spec.board_clearance + rules.design_margin, board.HOLE[0].y + max(hole_ko_0.d, rules.driver_diameter)/2 + rules.design_margin, board.HOLE[1].y + max(hole_ko_1.d, rules.driver_diameter)/2 + rules.design_margin, board.HOLE[2].y + max(hole_ko_2.d, rules.driver_diameter)/2 + rules.design_margin, board.HOLE[3].y + max(hole_ko_3.d, rules.driver_diameter)/2 + rules.design_margin)",
        "z0": "min(board.PCB_BOTTOM.z - spec.keepout_below - rules.design_margin, board.PCB_BOTTOM.z - ((max(fastener.board.min_engagement, fastener.board.length - (board.PCB_TOP.z - board.PCB_BOTTOM.z))) + rules.design_margin) - rules.min_feature + floor - rules.design_margin)",
        "z1": "max(board.PCB_TOP.z + spec.keepout_above + rules.design_margin, board.bbox.max_z + spec.headroom + rules.design_margin)",
        "wall": "min(max(rules.wall_default, spec.wall_min), spec.wall_max)",
        "floor": "min(max(rules.floor_default, spec.wall_min), spec.wall_max)",
        "x": "x1 - x0",
        "y": "y1 - y0",
        "z": "z1 - z0",
        "cx": "(x0 + x1) / 2",
        "cy": "(y0 + y1) / 2",
        "boss_d": "max(fastener.lid.min_boss_od + rules.design_margin, fastener.lid.pilot_diameter + 2*rules.boss_wall_min, fastener.lid.clearance_diameter + 2*(rules.min_ligament + rules.design_margin))",
        "band": "boss_d + spec.board_clearance + rules.design_margin"
      },
